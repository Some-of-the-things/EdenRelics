{
  "manifest_version": 3,
  "name": "Eden Relics — vintage crosslister",
  "version": "0.1.0",
  "description": "Fills your Vinted and Depop listing forms from one Eden Relics record. You review the form and press publish yourself.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.vinted.co.uk/*",
    "https://*.depop.com/*",
    "https://api.edenrelics.co.uk/*",
    "https://api-staging.edenrelics.co.uk/*",
    "https://eden-relics-tool.fly.dev/*",
    "http://localhost:5260/*",
    "http://localhost:5045/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Eden Relics crosslister"
  },
  "content_scripts": [
    {
      "matches": [
        "https://edenrelics.co.uk/*",
        "https://www.edenrelics.co.uk/*",
        "https://staging.edenrelics.co.uk/*",
        "http://localhost:4200/*"
      ],
      "js": ["src/content/boot-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.vinted.co.uk/*", "https://*.depop.com/*"],
      "js": ["src/content/boot-listing.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/content/platforms/*.js", "src/shared/*.js"],
      "matches": [
        "https://*.vinted.co.uk/*",
        "https://*.depop.com/*",
        "https://edenrelics.co.uk/*",
        "https://www.edenrelics.co.uk/*",
        "https://staging.edenrelics.co.uk/*",
        "http://localhost:4200/*"
      ]
    }
  ]
}
